<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ROS 2 Control macro for Ruiyan RH2 Hand
    This macro adds ros2_control tags to the robot description
    Supports both real hardware and mock hardware configurations
  -->

  <xacro:macro name="ruiyan_rh2_hand_ros2_control" params="
    name:=ruiyan_rh2_hand
    hand_id:=1
    use_mock_hardware:=false
    prefix:=''
    ">

    <ros2_control name="${prefix}${name}" type="system" rw_rate="50">

      <!-- Hardware interface plugin chosen conditionally -->
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="position_state_following_offset">0.0</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>ruiyan_rh2_hand_ros2_control/RuiyanRH2HandHardwareInterface</plugin>
          <param name="hand_id">${hand_id}</param>
        </xacro:unless>
      </hardware>

      <!-- Joint definitions based on URDF analysis -->
      <!-- Thumb joints -->
      <joint name="${prefix}thumb_proximal_yaw_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">2.356</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}thumb_proximal_pitch_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.698</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Four finger joints -->
      <joint name="${prefix}index_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.518</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}middle_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.571</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}ring_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.571</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}pinky_proximal_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.545</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>